# Enable the official Google Maps Embed API version of the company map.
# Without this variable, the site automatically uses OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_EMBED_API_KEY
NEXT_PUBLIC_SITE_URL=https://www.example.com

# CMS database and single-admin authentication
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME

# Production media storage (Supabase Storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=media
NEXT_PUBLIC_MEDIA_BASE_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/media
